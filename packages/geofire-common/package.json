{
  "name": "geofire-common",
  "description": "Location-based querying and filtering using Firebase",
  "version": "7.0.0",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "coverage": "nyc report --reporter=text-lcov > ./coverage/lcov.info",
    "lint": "eslint src/**/*.ts",
    "test": "nyc --reporter=html --reporter=text mocha --exit",
    "prepare": "npm run build"
  },
  "author": "VladasCZE",
  "homepage": "https://github.com/VladasCZEgeofire-js/",
  "repository": {
    "type": "git",
    "url": "https://github.com/VladasCZE/geofire-js.git"
  },
  "bugs": {
    "url": "https://github.com/VladasCZE/geofire-js/issues"
  },
  "license": "MIT",
  "keywords": [
    "geoquery",
    "location",
    "firebase",
    "realtime",
    "geolocation"
  ],
  "main": "dist/geofire-common/index.cjs.js",
  "index": "dist/geofire-common/index.js",
  "browser": "dist/geofire-common/geofire-common.min.js",
  "module": "dist/geofire-common/index.esm.js",
  "typings": "dist/geofire-common/index.d.ts",
  "files": [
    "dist/**",
    "LICENSE",
    "package.json"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "26.4.0",
    "chai": "6.2.2",
    "coveralls": "3.1.1",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "jsdom-global": "3.0.2",
    "mocha": "11.8.0",
    "nyc": "18.0.0",
    "rollup": "4.63.1",
    "rollup-plugin-commonjs": "10.1.0",
    "rollup-plugin-node-resolve": "5.2.0",
    "@rollup/plugin-terser": "0.4.4",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.70.0"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "html"
    ],
    "all": true
  }
}
